# Copy to .env and load it with `set -a; . ./.env; set +a`, or pass it to docker with --env-file.
# Every variable is optional; the defaults work for local development.
# (Keep comments on their own lines: env files do not support trailing comments.)

# Where the SQLite database lives (default: taskmanager/data)
#TASKMANAGER_DATA_DIR=/var/lib/taskmanager

# Paging for the list endpoints
#TASKMANAGER_PAGE_SIZE=20
#TASKMANAGER_MAX_PAGE_SIZE=100

# JWT lifetimes
#TASKMANAGER_ACCESS_TOKEN_MINUTES=60
#TASKMANAGER_REFRESH_TOKEN_DAYS=7

# Standard Django knobs
#TASKMANAGER_SECRET_KEY=generate-a-long-random-string-for-servers
#TASKMANAGER_DEBUG=false
#TASKMANAGER_ALLOWED_HOSTS=tasks.example.com,127.0.0.1
#TASKMANAGER_LOG_LEVEL=INFO

# Container only: run migrations on start (default true); gunicorn worker count (default 4)
#TASKMANAGER_MIGRATE_ON_START=false
#WEB_CONCURRENCY=4
